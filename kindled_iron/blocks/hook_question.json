{
 "_help": "Line 1. The hook question in a big popup over a clip; the guide points, a confused reaction pops up.",
 "slots": {
  "question_text": "big popup text, 2-4 words (e.g. WHO MADE GOD?)",
  "clip_query": "stock clip search words (e.g. earth from space)",
  "point_word": "a word of the line: the guide points at the popup",
  "reaction_word": "a word of the line: the confused reaction card appears"
 },
 "beat": {
  "camera_start": {
   "x": 540,
   "y": 960,
   "zoom": 1.0,
   "dur": 0.01
  }
 },
 "events": [
  {
   "at": 0,
   "do": "place",
   "who": "guide",
   "x": 600
  },
  {
   "at": 0,
   "do": "size",
   "who": "guide",
   "value": 0.85,
   "dur": 0.01
  },
  {
   "at": 0,
   "do": "draw",
   "id": "{{id}}_clip",
   "type": "inset",
   "x": 540,
   "y": 410,
   "w": 820,
   "h": 470,
   "query": "{{clip_query}}",
   "sources": [
    "pexels",
    "pixabay",
    "nasa",
    "commons"
   ],
   "clip_dur": 2.2
  },
  {
   "at": 0,
   "do": "draw",
   "id": "{{id}}_q",
   "type": "popup",
   "x": 540,
   "y": 560,
   "w": 760,
   "h": 150,
   "text": "{{question_text}}",
   "size": 104,
   "instant": true,
   "pop": false
  },
  {
   "at": 0.05,
   "do": "wiggle",
   "id": "{{id}}_q"
  },
  {
   "at": "{{point_word}}",
   "do": "point",
   "who": "guide",
   "toward": "{{id}}_q",
   "hold": 0.5
  },
  {
   "at": "{{reaction_word}}",
   "reaction": "confused",
   "face": "confused_math",
   "dur": 1.4,
   "allow_god": true,
   "card": {
    "x": 330,
    "y": 1040,
    "w": 320,
    "h": 250,
    "rotate": -4
   }
  }
 ]
}
