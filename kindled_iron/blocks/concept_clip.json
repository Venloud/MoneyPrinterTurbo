   "do": "place",
   "who": "guide",
   "x": 620
  },
  {
   "at": 0,
   "do": "size",
   "who": "guide",
   "value": 0.9,
   "dur": 0.01
  },
  {
   "at": 0.15,
   "do": "draw",
   "id": "{{id}}_clock",
   "type": "clock",
   "x": 540,
   "y": 410,
   "r": 220,
   "dur": 0.4
  },
  {
