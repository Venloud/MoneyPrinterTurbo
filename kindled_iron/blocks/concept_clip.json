{
 "_help": "Explain one idea: a clip on one word, a big label and an accent sub-label, the guide looks up and points.",
 "slots": {
  "clip_query": "clip search words",
  "clip_word": "word where the clip starts",
  "label_text": "big label, 1-2 words (e.g. TIME)",
  "label_word": "word where it appears",
  "sub_text": "accent sub-label, 2-4 words (e.g. made by God)",
  "sub_word": "word where it appears"
 },
 "events": [
