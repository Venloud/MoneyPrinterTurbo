          "id": "ki_argument",
          "text": "GOD + EVIL?",
          "x": 310,
          "y": 1010,
          "size": 55,
          "dur": 0.3,
          "main": true
        },
        {
          "at": 0.18,
          "do": "point",
          "who": "guide",
          "toward": "ki_argument",
          "hold": 0.7
        },
        {
          "at": 1.25,
          "do": "express",
          "who": "guide",
          "expression": "curious"
        }
      ],
      "camera_start": false,
      "interaction": false
    },
    {
      "id": "freedom",
      "panel": 0,
      "narration": "Well, there's something this graph leaves out. Free will. Think about it. If God controlled every decision you made, would you really have a choice?",
