{
 "_help": "A Bible quote: a clip, then the scripture card while the quote is spoken (WEB-checked). The quote MUST be spoken word for word in the line.",
 "slots": {
  "ref": "reference (e.g. Psalm 90:2)",
  "verse": "card text = the spoken quote, a contiguous part of the WEB verse",
  "clip_query": "clip search words (e.g. old bible open pages)",
  "note_text": "optional: accent note under the card (e.g. no start)",
  "note_word": "optional: word where the note appears"
 },
 "beat": {
  "serious": true
 },
 "events": [
  {
   "at": 0,
   "do": "place",
   "who": "guide",
   "x": 650
  },
  {
   "at": 0,
   "do": "size",
   "who": "guide",
   "value": 0.85,
   "dur": 0.01
  },
  {
   "at": 0.1,
   "do": "draw",
   "id": "{{id}}_clip",
   "type": "inset",
   "x": 540,
   "y": 410,
   "w": 820,
   "h": 470,
   "query": "{{clip_query}}",
   "sources": [
    "pexels",
    "pixabay",
    "commons"
   ],
   "clip_dur": 2.4
  },
  {
   "at": 0.3,
   "do": "look",
   "who": "guide",
   "dir": "up",
   "expression": "curious",
   "hold": 0.5
  },
  {
   "scripture": {
    "ref": "{{ref}}",
    "text": "{{verse}}"
   },
   "x": 540,
   "y": 420,
   "size": 80,
   "w": 800
  },
  {
   "at": "end-0.6",
   "do": "look",
   "who": "guide",
   "dir": "up",
   "expression": "awe",
   "hold": 0.6
  },
  {
   "at": "end-0.3",
   "do": "point",
   "who": "guide",
   "toward": "{{card_id}}",
   "hold": 0.5
  },
  {
   "at": "{{note_word}}-0.1",
   "do": "draw",
   "id": "{{id}}_n",
   "type": "word",
   "text": "{{note_text}}",
   "x": 290,
   "y": 1100,
   "size": 100,
   "color": "accent",
   "dur": 0.3
  },
  {
   "at": "{{note_word}}+0.2",
   "do": "point",
   "who": "guide",
   "toward": "{{id}}_n",
   "hold": 0.5
  }
 ]
}
